APP_NAME="Hotel Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Used for "today" in date validation. Example: Asia/Kolkata
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box (database/database.sqlite is created by `composer setup`).
DB_CONNECTION=sqlite
# For MySQL instead:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hotel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Hotel details shown on the public site ---
HOTEL_NAME="Grand Stay Hotel"
HOTEL_TAGLINE="Comfortable rooms, warm hospitality."
HOTEL_ADDRESS="12 Park Street, Kolkata, West Bengal"
HOTEL_PHONE="+91 00000 00000"
HOTEL_EMAIL="hello@example.com"
HOTEL_CURRENCY="$"

# --- Admin account created by `php artisan db:seed` (CHANGE THE PASSWORD) ---
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
